# Server
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data

# AI（也可在网页「设置」里填写，优先生效）
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_IMAGE_MODEL=dall-e-3
AI_ENABLE_IMAGE=false

# WordPress（可选，也可在网页设置）
WP_URL=
WP_USER=
WP_APP_PASSWORD=

# 调度（网页可改）
AUTO_RUN=true
CRON_COLLECT=*/30 * * * *
CRON_PROCESS=*/10 * * * *
CRON_PUBLISH=*/15 * * * *

# 管理后台简易鉴权（留空则不鉴权，仅建议内网）
ADMIN_TOKEN=
